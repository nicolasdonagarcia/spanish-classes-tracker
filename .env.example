# Copy this file to .env.local for local development.
# On Vercel, add the same variables in Project → Settings → Environment Variables.

# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Random secret for login sessions. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# ── Optional ──────────────────────────────────────────────
# Database name (default: registro-clases)
# MONGODB_DB="registro-clases"

# Only needed if you use a custom domain, e.g. https://clases.midominio.com
# BETTER_AUTH_URL="https://clases.midominio.com"

# Timezone used for "today" / "this month" (default: America/New_York)
# NEXT_PUBLIC_TIMEZONE="America/New_York"

# Currency for amounts (default: USD)
# NEXT_PUBLIC_CURRENCY="USD"
